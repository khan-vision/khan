          "price": {
            "description": "Үнэ. Decimal: JSON тоо эсвэл тоон мөр; бутархай ≤ 2 орон. Том дүнг (\u003e15 цифр) тоон мөрөөр илгээ",
            "oneOf": [
              {
                "minimum": 0,
