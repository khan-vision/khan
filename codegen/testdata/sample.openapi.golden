    "/api/organization/conference/rooms/options/{field}": {
      "get": {
        "operationId": "optionsConferenceRoom",
        "parameters": [
          {
            "description": "Ref талбарын нэр; child-д `\u003cchild\u003e.\u003cfield\u003e`",
            "in": "path",
            "name": "field",
            "required": true,
            "schema": {
              "enum": [
                "equipment.item_id",
                "manager_id",
                "owner_id"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "description": "a,b,c (дээд 200); search/parent-ийг үл тооно",
            "in": "query",
            "name": "ids",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Parent-тэй талбарууд: owner_id",
            "in": "query",
            "name": "parent",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptionList"
                }
              }
            },
            "description": "Сонголтууд (өөрийн org-ийнх)"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "summary": "Хурлын өрөө — ref сонголтууд",
        "tags": [
          "Хурлын өрөө"
        ]
      }
    },
