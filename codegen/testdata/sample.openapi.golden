{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "JSON/id/шүүлтийн формат буруу, body хэт том"
      },
      "Conflict": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Version зөрсөн, unique/FK constraint, hook conflict"
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Can(action) == false"
      },
      "Internal": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Дотоод алдаа (жинхэнэ алдаа body-д гарахгүй)"
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Мөр байхгүй ЭСВЭЛ өөр org-ийнх (ялгахгүй)"
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "org/JWT алга"
      },
      "Unprocessable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        },
        "description": "Талбарын шалгалт, ref-ийн org, unique, children"
      }
    },
    "schemas": {
      "BulkResult": {
        "properties": {
          "affected": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "affected"
        ],
        "type": "object"
      },
      "Can": {
        "properties": {
          "create": {
            "type": "boolean"
          },
          "delete": {
            "type": "boolean"
          },
          "read": {
            "type": "boolean"
          },
          "update": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ConferenceRoom": {
        "additionalProperties": true,
        "description": "Хурлын өрөө — дэлгэрэнгүй мөр",
        "properties": {
          "active": {
            "description": "Идэвхтэй",
            "type": [
              "boolean",
              "null"
            ]
          },
          "area": {
            "description": "Талбай (м2). Decimal, яг цифртэй JSON тоо; бутархай ≤ 3 орон",
            "maximum": 9999.5,
            "minimum": 0.5,
            "type": "number"
          },
          "capacity": {
            "description": "Багтаамж",
            "format": "int64",
            "maximum": 100000,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "code": {
            "description": "Код \"A\" */ \u003cb\u003e",
            "maxLength": 20,
            "pattern": "(?i)^[a-z0-9-]+$",
            "type": [
              "string",
              "null"
            ]
          },
          "contacts": {
            "items": {
              "$ref": "#/components/schemas/ConferenceRoomContacts"
            },
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "created_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "deleted_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "description": "Тайлбар",
            "maxLength": 10000,
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "description": "Имэйл",
            "format": "email",
            "maxLength": 120,
            "type": [
              "string",
              "null"
            ]
          },
          "equipment": {
            "items": {
              "$ref": "#/components/schemas/ConferenceRoomEquipment"
            },
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "manager_id": {
            "description": "Менежер",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "description": "Мета. Дурын JSON"
          },
          "note": {
            "description": "Тэмдэглэл",
            "type": [
              "string",
              "null"
            ]
          },
          "open_time": {
            "description": "Нээх цаг",
            "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$",
            "type": [
              "string",
              "null"
            ]
          },
          "opens": {
            "description": "Нээх огноо",
            "format": "date",
            "type": [
              "string",
              "null"
            ]
          },
          "org_id": {
            "format": "uuid",
            "type": "string"
          },
          "owner_id": {
            "description": "Эзэмшигч",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "description": "Утас. Монгол 8 оронтой дугаар (+976 хасагдана) эсвэл E.164 `+…`",
            "type": [
              "string",
              "null"
            ]
          },
          "price": {
            "description": "Үнэ. Decimal, яг цифртэй JSON тоо; бутархай ≤ 2 орон",
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "ref_code": {
            "description": "Лавлах UUID",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "room_name": {
            "description": "Нэр",
            "maxLength": 500,
            "minLength": 2,
            "type": "string"
          },
          "starts_at": {
            "description": "Эхлэх цаг",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "Төлөв",
            "enum": [
              "draft",
              "open",
              "closed",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "updated_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "ConferenceRoomContacts": {
        "additionalProperties": true,
        "description": "Холбоо барих",
        "properties": {
          "phone": {
            "description": "Утас. Монгол 8 оронтой дугаар (+976 хасагдана) эсвэл E.164 `+…`",
            "type": "string"
          },
