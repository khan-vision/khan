          "ref_code": {
            "description": "Лавлах UUID",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "room_name": {
            "description": "Нэр",
            "maxLength": 500,
            "minLength": 2,
            "type": "string"
          },
          "secret": {
            "description": "Нууц үг",
            "format": "password",
            "minLength": 8,
            "type": "string",
            "writeOnly": true
