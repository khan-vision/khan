          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "label": {
            "description": "Нэр",
            "maxLength": 255,
            "type": "string"
          },
          "org_id": {
            "format": "uuid",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "updated_by": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "TagCreate": {
        "description": "Шошго — үүсгэх хүсэлт",
        "properties": {
          "label": {
            "description": "Нэр",
            "maxLength": 255,
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "TagList": {
        "properties": {
          "can": {
            "$ref": "#/components/schemas/Can"
          },
          "data": {
            "items": {
              "additionalProperties": true,
              "description": "Жагсаалтын мөр (resource-ийн ListQuery-ийн SELECT-ээр тодорхойлогдоно)",
              "type": "object"
            },
            "type": "array"
          },
          "filterable": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "limit": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          },
          "totals": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "data",
          "total"
        ],
        "type": "object"
      },
      "TagUpdate": {
        "description": "Шошго — засах хүсэлт (хэсэгчилсэн)",
        "properties": {
          "label": {
            "description": "Нэр",
            "maxLength": 255,
            "type": "string"
          }
        },
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "error": {
            "examples": [
              "Мэдээлэл буруу"
            ],
            "type": "string"
          },
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "талбар → мессежүүд. Child талбарын түлхүүр: `lines.0.qty`",
            "type": "object"
          }
        },
        "required": [
          "error",
          "errors"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "JWT (Authorization: Bearer). org_id зөвхөн token-оос авагдана.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Khan ERP",
    "version": "1.2.3"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/organization/conference/rooms": {
      "get": {
        "operationId": "listConferenceRoom",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "enum": [
                "capacity",
                "room_name"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "dir",
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          {
            "description": "listquery шүүлт (JSON мөр). Шүүх боломжтой: capacity: number, room_name: text, status: enum",
            "in": "query",
            "name": "filters",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConferenceRoomList"
                }
              }
            },
            "description": "Жагсаалт"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "summary": "Хурлын өрөө — жагсаалт",
        "tags": [
          "Хурлын өрөө"
        ]
      },
      "post": {
        "operationId": "createConferenceRoom",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConferenceRoomCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConferenceRoom"
                }
              }
            },
            "description": "Үүссэн мөр"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "summary": "Хурлын өрөө — үүсгэх",
        "tags": [
          "Хурлын өрөө"
        ]
      }
    },
    "/api/organization/conference/rooms/bulk": {
      "post": {
        "description": "delete → delete эрх, update → update эрх шаардана. Бусад org-ийн id нөлөөлөхгүй (affected-д орохгүй).",
        "operationId": "bulkConferenceRoom",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "action": {
                    "enum": [
                      "delete",
                      "update"
                    ],
                    "type": "string"
                  },
                  "ids": {
                    "items": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "set": {
                    "additionalProperties": false,
                    "properties": {
                      "capacity": {
                        "description": "Багтаамж",
                        "format": "int64",
                        "maximum": 100000,
                        "minimum": 0,
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "status": {
                        "default": "draft",
                        "description": "Төлөв",
                        "enum": [
                          "draft",
                          "open",
                          "closed"
                        ],
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                },
                "required": [
                  "action",
                  "ids"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkResult"
                }
              }
            },
            "description": "Нөлөөлсөн мөрийн тоо"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        },
        "summary": "Хурлын өрөө — бөөнөөр засах/устгах",
        "tags": [
          "Хурлын өрөө"
        ]
      }
    },
    "/api/organization/conference/rooms/export.xlsx": {
      "get": {
        "operationId": "exportConferenceRoom",
        "parameters": [
          {
            "in": "query",
